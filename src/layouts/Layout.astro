---
import Head from '@/components/Head.astro'
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import '@/styles/global.css'
interface Props {
	title?: string
	description?: string
	image?: string
}
const { title, description, image } = Astro.props
---

<!doctype html>
<html lang="en">
  <Head title={ title } description={ description } image={ image } />
  <body data-scroll-container>
    <Header/>
    <main data-scroll-section>
      <slot />
    </main>
    <Footer/>
  </body>
</html>

<script>
  import LocomotiveScroll from 'locomotive-scroll'
  import { initReveal } from '@/scripts/reveal'
  import { initCarousels } from '@/scripts/carousel'
  import { initCounters } from '@/scripts/counter'
  import { initAccordions } from '@/scripts/accordion'

  interface ScrollInstance {
    destroy: () => void
  }

  let locomotiveScroll: ScrollInstance | null = null

  /**
   * Parallax is a desktop-only flourish: it runs from `xl` up. Below that the
   * columns it offsets are already stacked or narrow, so the drift reads as
   * misalignment rather than depth — and it costs a transform on every frame on
   * exactly the devices least able to spare one.
   */
  const parallaxQuery = window.matchMedia( '(width >= 1280px)' )

  /**
   * Locomotive only parallaxes elements that carry `data-scroll-speed`, and it
   * reads them once at construction. So the switch is the attribute itself:
   * park the value in `data-parallax-speed` while off, put it back when on, and
   * rebuild the instance. Any inline `transform` Locomotive already wrote has to
   * be cleared by hand — it doesn't unwind it on destroy.
   */
  const applyParallaxState = (): void => {
    const enabled = parallaxQuery.matches

    document
      .querySelectorAll<HTMLElement>( '[data-scroll-speed], [data-parallax-speed]' )
      .forEach(( element ) => {
        if ( enabled ) {
          const parked = element.dataset.parallaxSpeed
          if ( parked === undefined ) return
          element.setAttribute( 'data-scroll-speed', parked )
          delete element.dataset.parallaxSpeed
          return
        }

        const speed = element.getAttribute( 'data-scroll-speed' )
        if ( speed !== null ) {
          element.dataset.parallaxSpeed = speed
          element.removeAttribute( 'data-scroll-speed' )
        }
        element.style.transform = ''
      })
  }

  const createLocomotive = (): void => {
    locomotiveScroll?.destroy()
    applyParallaxState()

    // v5 is a different library from v4: it's built on Lenis and takes
    // `lenisOptions` / `triggerRootMargin` / `autoStart`. The old v4 keys
    // (`smooth`, `mobile`, `tablet`) don't exist here and were being dropped
    // silently. Smooth wheel and touch handling are v5 defaults.
    locomotiveScroll = new LocomotiveScroll()
  }

  const initScroll = (): void => {
    window.scrollTo(0, 0)

    initReveal()
    initCarousels()
    void initCounters()
    initAccordions()

    createLocomotive()
  }

  // Crossing the boundary only needs the scroll instance rebuilt — rerunning
  // `initScroll` would jump the page to the top and replay every reveal.
  parallaxQuery.addEventListener( 'change', createLocomotive )

  document.addEventListener("astro:page-load", () => {
    initScroll()
  })
</script>
