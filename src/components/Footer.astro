---
import { footerColumns, socialLinks, legal } from '@/data/footer'
import SocialIcon from '@/components/icons/SocialIcon.astro'
import TrustedChoiceBadge from '@/components/icons/TrustedChoiceBadge.astro'
import Container from '@/components/ui/Container.astro'
import Typography from '@/components/ui/Typography.astro'
---

<footer class="bg-neutral-900">
  <div class="rounded-tr-4xl bg-neutral-900">
    <Container class="flex flex-col items-start justify-between gap-8 py-15 xl:flex-row xl:gap-10">
      <div class="flex w-full shrink-0 flex-row items-center justify-between gap-4 xl:w-auto xl:justify-start xl:gap-8">
        <a href="/" aria-label="Inszone Insurance">
          <img src="/images/brand/logo-inszone-white.svg" alt="Inszone Insurance" width="124" height="56" />
        </a>
        <TrustedChoiceBadge />
      </div>

      <div class="grid w-full grid-cols-2 gap-8 xl:flex xl:w-auto xl:flex-wrap xl:pt-1.5">
        { footerColumns.map(({ title, links, width }) => (
          <div class:list={ [ 'flex flex-col gap-4', width === 'legal' && 'xl:w-41 xl:shrink-0' ] }>
            <Typography variant="inherit" as="div" class="relative pb-3.5 text-lg leading-tight font-bold text-white after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-16 after:rounded-full after:bg-primary-500 after:content-['']">
              { title }
            </Typography>
            { links.map(({ label, href }) => (
              <a
                href={ href }
                class="text-sm leading-5 text-neutral-300 no-underline transition-colors duration-150 hover:text-white"
              >
                { label }
              </a>
            ))}
          </div>
        ))}

        <div class="flex shrink-0 flex-col gap-4 xl:w-46 xl:pt-1.5">
          <Typography variant="inherit" as="div" class="relative pb-3.5 text-lg leading-tight font-bold text-white after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-16 after:rounded-full after:bg-primary-500 after:content-['']">
            Connect with Us
          </Typography>
          <div class="flex items-center gap-2">
            { socialLinks.map(({ network, href }) => (
              <a
                href={ href }
                target="_blank"
                rel="noopener"
                class="inline-flex size-10 items-center justify-center rounded-full bg-primary-500 text-white transition-opacity duration-150 hover:opacity-80 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-300"
              >
                <span class="inline-flex size-[18px]"><SocialIcon network={ network } /></span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </Container>
  </div>

  <div class="bg-neutral-900">
    <Container class="flex flex-col items-start gap-4 border-t border-white/16 py-7 text-sm leading-[1.4] text-neutral-300 md:flex-row md:items-center md:gap-7 md:py-8 md:whitespace-nowrap">
      <span>{ legal.copyright }</span>
      <span>{ legal.license }</span>
    </Container>
  </div>
</footer>
