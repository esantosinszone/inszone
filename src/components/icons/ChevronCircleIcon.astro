---
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'svg'>

const { class: className, ...rest } = Astro.props
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
  class:list={ [ 'size-full', className ] }
  { ...rest }
>
  <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="0.7"/>
  <path d="M16 10.5C16 10.5 13.054 13.5 12 13.5C10.9459 13.5 8 10.5 8 10.5" stroke="currentColor" stroke-width="0.7" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
