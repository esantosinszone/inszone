---
/**
 * Single typography component for the whole marketing site.
 *
 * Every piece of text on a page goes through here so the scale stays in one
 * place: pick the variant that matches the SIZE/ROLE you need, then override
 * the tone with `color` when the surface calls for it (dark bands, glass
 * panels, etc.).
 *
 * Sizes downshift on small viewports the same way the design does — the
 * marketing headings drop hard (40px -> 20px) because the mobile layout is a
 * single narrow column.
 */
import type { HTMLAttributes } from 'astro/types'
import type { HTMLTag } from 'astro/types'

/**
 * Display & headings — `display` and `h1` are hero-scale, `h2` is the section
 * title used almost everywhere. Body sizes sit under them, then the accents:
 * `eyebrow` for small uppercase labels and the two `stat*` variants for the
 * figures in the stats band. `inherit` opts out of styling entirely.
 */
export type TypographyVariant = 'display' | 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6' | 'lead' | 'body' | 'bodySm' | 'caption' | 'eyebrow' | 'statValue' | 'statLabel' | 'inherit'

export interface Props extends Omit<HTMLAttributes<'p'>, 'color'> {
  variant?: TypographyVariant
  /** Override the semantic tag. Each variant has a sensible default. */
  as?: HTMLTag
  /**
   * Override the text tone. Accepts a design token (`"primary-500"`,
   * `"neutral-600"`), a CSS keyword (`"white"`) or a raw CSS color.
   * Applied inline so it always beats the variant's own class.
   */
  color?: string
  /** Truncate to a single line with an ellipsis. */
  truncate?: boolean
  /** Clamp to N lines. */
  clamp?: number
}

const VARIANT_CLASS: Record<TypographyVariant, string> = {
  display:   'text-[2.5rem] md:text-[3.5rem] font-extrabold leading-[1.05] tracking-tight text-primary-950',
  h1:        'text-[2rem] md:text-5xl font-bold leading-[1.05] tracking-tight text-primary-950',
  h2:        'text-xl md:text-[2.5rem] font-bold leading-[0.9] text-primary-950',
  h3:        'text-xl md:text-[2rem] font-bold leading-[1.05] text-primary-950',
  h4:        'text-lg md:text-2xl font-bold leading-[1.1] text-primary-950',
  h5:        'text-lg md:text-xl font-bold leading-[1.1] text-primary-950',
  h6:        'text-base font-bold leading-snug text-primary-950',
  lead:      'text-base md:text-lg font-normal leading-[1.3] text-neutral-600',
  body:      'text-sm md:text-base font-normal leading-[1.4] text-neutral-600',
  bodySm:    'text-sm font-normal leading-[1.4] text-neutral-600',
  caption:   'text-xs font-normal leading-[1.4] text-neutral-500',
  eyebrow:   'text-xs font-bold uppercase tracking-[0.08em] text-primary-500',
  statValue: 'text-2xl md:text-5xl lg:text-[6rem] font-extrabold leading-none',
  statLabel: 'text-xs md:text-base lg:text-2xl font-semibold leading-[1.1]',
  inherit:   '',
}

const DEFAULT_TAG: Record<TypographyVariant, HTMLTag> = {
  display: 'h1', h1: 'h1', h2: 'h2', h3: 'h3', h4: 'h4', h5: 'h5', h6: 'h6',
  lead: 'p', body: 'p', bodySm: 'p', caption: 'span',
  eyebrow: 'p', statValue: 'span', statLabel: 'span', inherit: 'span',
}

/** Token (`primary-500`) -> CSS var; anything else passes through untouched. */
const resolveColor = ( value?: string ): string | undefined => {
  if ( !value ) return undefined
  if ( /^(var\(|#|rgb|hsl|oklch)/.test( value )) return value
  if ( /^[a-z]+(-\d{2,3})?$/.test( value )) return `var(--color-${ value }, ${ value })`
  return value
}

const {
  variant = 'body',
  as,
  color,
  truncate,
  clamp,
  class: className,
  style,
  ...rest
} = Astro.props

const Tag = as ?? DEFAULT_TAG[ variant ]
const resolved = resolveColor( color )
const clampStyle = clamp
  ? `display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:${ clamp };overflow:hidden;`
  : ''
const inlineStyle = [ resolved && `color:${ resolved };`, clampStyle, style ]
  .filter( Boolean )
  .join( '' )
---

<Tag
  data-variant={ variant }
  class:list={ [ VARIANT_CLASS[ variant ], truncate && 'truncate', className ] }
  style={ inlineStyle || undefined }
  { ...rest }
>
  <slot />
</Tag>
