---
/** One customer testimonial inside the testimonials strip. */
import Stars from '@/components/ui/Stars.astro'
import Typography from '@/components/ui/Typography.astro'

interface Props {
  title: string
  body: string
  author: string
  location: string
  date: string
  rating: number
  class?: string
}

const { title, body, author, location, date, rating, class: className } = Astro.props
---

<article class:list={ [ 'flex flex-col gap-8 bg-white p-5 md:p-8', className ] }>
  <div class="flex flex-col gap-0.5">
    <Typography variant="inherit" as="h3" class="text-xl leading-tight font-extrabold text-primary-700 md:text-2xl md:leading-[1.4]">
      { title }
    </Typography>
    <Typography variant="bodySm">{ body }</Typography>
  </div>
  <div class="flex flex-col gap-2">
    <Stars value={ rating } />
    <div class="flex flex-col">
      <Typography variant="inherit" as="span" class="text-sm leading-tight font-bold text-primary-950 md:text-base md:leading-[1.4]">
        { author }<strong class="block font-bold md:inline"> { location }</strong>
      </Typography>
      <Typography variant="inherit" as="span" class="text-sm leading-[1.4] font-medium text-neutral-400">
        { date }
      </Typography>
    </div>
  </div>
</article>
