---
/** Icon + label + caption tile used inside the feature trio panel. */
import type { IconSvgElement } from '@hugeicons/react'
import Icon from '@/components/icons/Icon.astro'
import Card from '@/components/ui/Card.astro'
import Typography from '@/components/ui/Typography.astro'

interface Props {
  label: string
  caption: string
  icon: IconSvgElement
  class?: string
}

const { label, caption, icon, class: className } = Astro.props
/** Labels carry a hard break so the two-line rhythm survives the wide layout. */
const lines = label.split( '\n' )
---

<Card
  radius="md"
  class:list={ [
    'flex flex-1 flex-col gap-2 px-4 pt-3 pb-4 md:gap-4 md:rounded-2xl md:px-10 md:pt-8 md:pb-10',
    className,
  ] }
>
  <span class="inline-flex size-12 shrink-0 md:size-16 text-primary-950" aria-hidden="true">
    <Icon icon={ icon } />
  </span>
  <div class="flex flex-col gap-2 md:gap-4">
    <Typography variant="inherit" as="h3" class="text-xs leading-tight font-bold text-primary-950 md:text-2xl md:leading-[1.1]">
      { lines.map(( line, index ) => (
        <Fragment>{ index > 0 && <br /> }{ line }</Fragment>
      ))}
    </Typography>
    <Typography variant="body" class="hidden md:block">{ caption }</Typography>
  </div>
</Card>
