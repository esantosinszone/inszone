---
/** Star rating row. `value` is out of 5 and rounds to the nearest half. */
import StarIcon from '@/components/icons/StarIcon.astro'

interface Props {
  value: number
  size?: 'sm' | 'md'
  gap?: 'tight' | 'loose'
  class?: string
}

const { value, size = 'sm', gap = 'tight', class: className } = Astro.props

/**
 * Any fraction shows as a half star rather than rounding to the nearest half —
 * a 4.2 and a 4.8 both read as "four and a bit", which is how the review
 * platforms themselves display it.
 */
const full = Math.floor( value )
const stars = Array.from({ length: 5 }, ( _, index ) => {
  if ( index < full ) return 'full' as const
  if ( index === full && value % 1 > 0 ) return 'half' as const
  return 'empty' as const
})

const SIZE = { sm: 'size-4', md: 'size-5' }
const GAP = { tight: 'gap-[3px]', loose: 'gap-2 md:gap-3' }
---

<span
  role="img"
  aria-label={ `${ value } out of 5 stars` }
  class:list={ [ 'inline-flex', GAP[ gap ], className ] }
>
  { stars.map(( fill ) => <StarIcon fill={ fill } class={ SIZE[ size ] } />) }
</span>
