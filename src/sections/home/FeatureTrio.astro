---
/** Tinted panel: pitch on the left, three value cards on the right. */
import { features } from '@/data/home'
import { ArrowRight02Icon } from '@hugeicons/core-free-icons'
import Container from '@/components/ui/Container.astro'
import Button from '@/components/ui/Button.astro'
import Card from '@/components/ui/Card.astro'
import FeatureCard from '@/components/ui/FeatureCard.astro'
import Typography from '@/components/ui/Typography.astro'
---

<section class="stack bg-white max-md:bg-primary-100">
  <Container width="wide" flush class="py-[var(--section-py)] max-md:py-0">
    <Card
    tone="tint"
      class="flex flex-col items-start gap-5 px-[var(--section-pad)] py-[var(--section-py)] max-md:rounded-none max-md:bg-transparent md:gap-8 xl:flex-row xl:gap-12 xl:p-20"
  >
    <div class="flex w-full shrink-0 flex-col gap-1 xl:w-80">
      <Typography
        variant="inherit"
        as="h2"
        class="reveal-left text-xl leading-none font-bold text-primary-500 md:text-[32px]"
      >
        <strong class="block font-bold text-primary-950 md:inline">An Insurance Provider</strong>
        with a Proven Strategy to Help You
      </Typography>
      <Typography variant="body" class="reveal-left hidden md:block">
        Smarter insurance solutions made for you. Get expert guidance, save on premiums, and manage
        your policy with ease.
      </Typography>
      <Button href="/quote" size="lg" icon={ ArrowRight02Icon } class="reveal-left mt-6 self-start">
        Request a quote
      </Button>
    </div>

    <div class="flex w-full flex-1 items-stretch gap-3 md:gap-6">
      { features.map(( feature ) => (
        <FeatureCard { ...feature } class="reveal-up" />
      ))}
    </div>
    </Card>
  </Container>
</section>
