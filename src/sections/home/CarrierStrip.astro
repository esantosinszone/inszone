---
/** Tinted panel with the carrier logos scrolling on an infinite marquee. */
import { carriers } from '@/data/home'
import Container from '@/components/ui/Container.astro'
import Marquee from '@/components/ui/Marquee.astro'
import Typography from '@/components/ui/Typography.astro'
---

<!-- The pull-up only exists where there's a hero photo to tuck under (xl+).
     Below that the hero is just its panel, so the strip sits in normal flow —
     otherwise it would ride 208px up over the copy. -->
<section class="stack relative reveal-fade max-md:bg-primary-50 xl:-mt-52">
  <Container width="wide" flush>
    <!-- xl:pt-44 clears the hero photo that overlaps into this panel via the
         section's -mt-52; it is not section rhythm. -->
    <div class="flex flex-col items-center gap-6 rounded-3xl bg-primary-50 px-[var(--section-pad)] py-[var(--section-py)] max-md:rounded-none max-md:bg-transparent md:gap-10 xl:pt-44">
    <div class="flex max-w-[1020px] flex-col gap-3 text-center">
      <Typography variant="h2">The Best Insurance Companies For You</Typography>
      <Typography variant="body">
        We carefully handpick trusted insurance providers, focusing on more than just coverage and
        price. Each company is evaluated for its reliability, financial stability, and commitment to
        customer service, so you can feel confident in your choice.
      </Typography>
    </div>
    <!-- Bleeds past the panel padding so the edge fade lands on the panel's
         own corners instead of floating inside it. -->
    <Marquee
      speed={ 45 }
      gap={ 64 }
      class="-mx-4 w-[calc(100%+2rem)] md:-mx-6 md:w-[calc(100%+3rem)]"
    >
      { carriers.map(({ name, logo }) => (
        <span class="inline-flex h-8 items-center justify-center md:h-10">
          <img
            src={ logo }
            alt={ name }
            loading="lazy"
            class="h-auto max-h-full w-auto max-w-[140px] object-contain"
          />
        </span>
      ))}
    </Marquee>
    </div>
  </Container>
</section>
