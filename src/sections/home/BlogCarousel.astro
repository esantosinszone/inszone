---
/** Latest posts in a snap carousel. */
import { posts } from '@/data/home'
import ArrowRightSmallIcon from '@/components/icons/ArrowRightSmallIcon.astro'
import BlogCard from '@/components/ui/BlogCard.astro'
import Carousel from '@/components/ui/Carousel.astro'
import Container from '@/components/ui/Container.astro'
import Typography from '@/components/ui/Typography.astro'
---

<section class="rounded-t-3xl bg-neutral-100 md:rounded-none">
  <Container class="flex flex-col gap-4 py-10 md:gap-8 md:py-16">
    <div class="flex flex-col items-stretch justify-between gap-3 md:flex-row md:items-center md:gap-4">
      <div class="flex flex-col gap-6">
        <Typography variant="h2" class="reveal-left">Stay Informed with the Latest Updates</Typography>
        <Typography variant="body" class="reveal-left hidden md:block">
          Our blog offers industry news and updates to help you stay informed about your coverage.
        </Typography>
      </div>
      <a
        href="/blog"
        class="reveal-right inline-flex h-10 shrink-0 items-center justify-center gap-2 rounded-lg bg-primary-100 px-4 text-sm leading-none font-semibold text-primary-700 no-underline transition-colors duration-150 hover:bg-primary-200 md:h-auto md:justify-start md:px-6 md:py-4 md:text-base"
      >
        More Articles
        <span class="inline-flex size-4"><ArrowRightSmallIcon /></span>
      </a>
    </div>

    <Carousel id="blog" pages={ 4 } autoplay={ 3000 } class="reveal-fade">
      { posts.map(( post ) => <BlogCard { ...post } />) }
    </Carousel>
  </Container>
</section>
