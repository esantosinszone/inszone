---
export interface ServiceProps {
  producer: string;
  agencyCommission: string;
  color: string;
}

const leaderboard: ServiceProps[] = [
  {
    producer: "Theresa Graves",
    agencyCommission: "$14,897.91",
    color: "#002E4E",
  },
  {
    producer: "Scott Stiverson",
    agencyCommission: "$10,078.95",
    color: "#2C547C",
  },
  {
    producer: "Sandy Merrill",
    agencyCommission: "$7,040.20",
    color: "#5979A9",
  },
  {
    producer: "Zack Weinberger",
    agencyCommission: "$6,960.36",
    color: "#89A1CC",
  },
  {
    producer: "Stephanie Osorio",
    agencyCommission: "$6,891.90",
    color: "#BECCE3",
  },
];
---

<section class="w-full flex justify-center">
  <div class="w-full max-w-5xl px-4 lg:px-0">
    <div class="relative lg:pt-[100px]">
      <img
        src="/images/graphic/graphic-leaderboard.png"
        alt="Leaderboard"
        class="relative z-20 w-full lg:mb-0 mb-6"
      />
      <div
        class="flex
          flex-col
          lg:flex-row
          lg:absolute
          relative
          lg:left-[102px]
          -top-6
          lg:top-0
          lg:w-full
          lg:h-full
          z-10"
      >
        {
          leaderboard.map((item, index) => (
            <div
              class="
                flex
                lg:flex-1
                flex-row
                lg:flex-col
                gap-4
                py-5
                lg:py-0
                relative
                lg:h-[120px]
                lg:border-l-2
                lg:border-b-0
                border-b
                border-b-gray-300
                last:border-b-0
                lg:pl-4
                top-0
                lg:top-(--offset)
              "
              style={`--offset: ${index * 36}px; border-left-color: ${item.color}`}
            >
              <div class="lg:hidden w-10 shrink-0 flex justify-center">
                <span class="text-4xl font-bold leading-none text-primary-300">
                  {index + 1}
                </span>
              </div>
              <div class="flex flex-col gap-4">
                <div class="flex flex-col gap-1">
                  <span class="uppercase leading-none text-gray-500 text-xs">
                    Producer
                  </span>
                  <span class="text-primary-700 font-bold leading-none">
                    {item.producer}
                  </span>
                </div>

                <div class="flex flex-col gap-1">
                  <span class="uppercase leading-none text-gray-500 text-xs">
                    Agency Commission
                  </span>
                  <span class="text-primary-700 text-lg font-bold leading-none">
                    {item.agencyCommission}
                  </span>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
