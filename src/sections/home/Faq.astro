---
/** Accordion list of the most common customer questions. */
import { faqs } from '@/data/home'
import { ArrowRight02Icon } from '@hugeicons/core-free-icons'
import Container from '@/components/ui/Container.astro'
import Accordion from '@/components/ui/Accordion.astro'
import Button from '@/components/ui/Button.astro'
import Typography from '@/components/ui/Typography.astro'
---

<section class="stack bg-white">
  <Container width="narrow" class="flex flex-col gap-8 py-[var(--section-py)]">
    <div class="flex flex-col gap-3">
      <Typography variant="inherit" as="p" class="reveal-left text-sm leading-none font-medium text-neutral-600 md:text-2xl">
        Help &amp; Support
      </Typography>
      <Typography variant="h2" class="reveal-left">Frequently Asked Questions</Typography>
      <Typography variant="body" class="reveal-left">
        Explore answers to our most common customer questions. Our FAQ section offers clear
        explanations and guidance to help you understand our services, policies, and processes with
        ease.
      </Typography>
    </div>

    <div class="flex flex-col overflow-hidden rounded-xl border border-neutral-200 bg-white md:rounded-lg">
      { faqs.map(({ question, answer }, index) => (
        <Accordion title={ question } open={ index === 0 } group="faq" class="border-b border-neutral-200 last:border-b-0">
          <Fragment set:html={ answer } />
        </Accordion>
      ))}
    </div>

    <div class="flex justify-center">
      <Button href="/faqs" variant="soft" size="lg" icon={ ArrowRight02Icon } class="reveal-up">Read More</Button>
    </div>
  </Container>
</section>
